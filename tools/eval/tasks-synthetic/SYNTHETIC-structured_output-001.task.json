{
  "id": "SYNTHETIC-structured_output-001",
  "category": "structured_output",
  "synthetic": true,
  "description": "SYNTHETIC: invoice extraction into a fixed JSON schema; strict parsing (the whole answer must be JSON); value checks.",
  "messages": [
    {"role": "system", "content": "You convert documents to JSON. Output only one JSON object, no prose, no code fences."},
    {"role": "user", "content": "Convert this invoice to JSON with keys invoice_id (string), date (YYYY-MM-DD), currency (EUR, USD or GBP), items (list of {sku, qty, unit_price}) and total (number, sum of qty * unit_price).\n\nINVOICE INV-2026-0042\nDate: 14 March 2026\nBill to: Northwind Traders\nItems:\n  3 x Widget A (SKU W-A) @ 4.50\n  1 x Gadget Pro (SKU G-PRO) @ 120.00\n  10 x Cable 2m (SKU CBL-2) @ 2.25\nAll prices in EUR."}
  ],
  "response_format": {"type": "json_object"},
  "check": {
    "type": "json_schema",
    "parse": "strict",
    "schema": {
      "type": "object",
      "required": ["invoice_id", "date", "currency", "items", "total"],
      "additionalProperties": false,
      "properties": {
        "invoice_id": {"type": "string", "pattern": "^INV-\\d{4}-\\d{4}$"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "currency": {"enum": ["EUR", "USD", "GBP"]},
        "items": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["sku", "qty", "unit_price"], "additionalProperties": false,
          "properties": {"sku": {"type": "string"}, "qty": {"type": "integer", "minimum": 1},
                         "unit_price": {"type": "number", "exclusiveMinimum": 0}}}},
        "total": {"type": "number"}
      }
    },
    "values": [
      {"path": "/invoice_id", "equals": "INV-2026-0042"},
      {"path": "/date", "equals": "2026-03-14"},
      {"path": "/currency", "equals": "EUR"},
      {"path": "/items", "length": 3},
      {"path": "/items/1/sku", "equals": "G-PRO"},
      {"path": "/total", "approx": 156.0, "tol": 0.005}
    ]
  },
  "reference_answer": "{\"invoice_id\": \"INV-2026-0042\", \"date\": \"2026-03-14\", \"currency\": \"EUR\", \"items\": [{\"sku\": \"W-A\", \"qty\": 3, \"unit_price\": 4.5}, {\"sku\": \"G-PRO\", \"qty\": 1, \"unit_price\": 120.0}, {\"sku\": \"CBL-2\", \"qty\": 10, \"unit_price\": 2.25}], \"total\": 156.0}"
}
