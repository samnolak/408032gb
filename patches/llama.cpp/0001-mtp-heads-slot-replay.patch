 src/llama-context.cpp       |  4 +++
 src/llama-ext.h             |  7 +++++
 src/llama-kv-cache-iswa.cpp |  7 +++++
 src/llama-kv-cache-iswa.h   |  2 ++
 src/llama-kv-cache.cpp      | 54 ++++++++++++++++++++++++++++++++++++
 src/llama-kv-cache.h        |  9 ++++++
 src/llama-memory.h          |  5 ++++
 8 files changed, 142 insertions(+), 1 deletion(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index d9ddf44..f117f9b 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -15,6 +15,7 @@
 #include <algorithm>
 #include <cassert>
 #include <cmath>
+#include <cstdlib>
 #include <cstring>
 #include <iomanip>
 #include <map>
@@ -1425,6 +1426,9 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     std::vector<int>                i_last;
     std::vector<std::vector<float>> chain_h;
 
+    // process(): place every ubatch once for all heads (llama_memory_set_slot_replay), see process()
+    bool slot_replay = false;
+
     common_speculative_impl_draft_mtp(const common_params_speculative & params, uint32_t n_seq)
         : common_speculative_impl(COMMON_SPECULATIVE_TYPE_DRAFT_MTP, n_seq, params.draft.n_max)
         , params(params.draft)
@@ -1482,6 +1486,15 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         chain_heads   = n_mtp_layers > 1 && !is_mem_shared;
 
         if (chain_heads) {
+            // the heads are layers of one MTP context and share its KV cells. process() re-decodes each target batch
+            // once per head after seq_rm; without slot replay a later head may get other cells (e.g. when the first
+            // head's batch wrapped around the end of a sliding-window ring), and the earlier heads' layers then hold
+            // K/V of other positions under those cells. LLAMA_SPEC_MTP_NO_SLOT_REPLAY=1 keeps the old placement.
+            const char * no_replay = std::getenv("LLAMA_SPEC_MTP_NO_SLOT_REPLAY");
+            slot_replay = !(no_replay && no_replay[0] == '1') &&
+                          llama_memory_set_slot_replay(llama_get_memory(ctx_dft), false);
+            SPC_TRC("- chain_heads: slot replay %s\n", slot_replay ? "on" : "off");
+
             this->params.n_max = std::min(this->params.n_max, n_mtp_layers);
 
             chain_h.assign(n_seq, {});
@@ -1536,6 +1549,43 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         }
     }
 
+    // process() with slot replay: one ubatch at a time, all heads on it before the next one. Head 0 places the chunk
+    // after seq_rm from the chunk's first position; heads 1 .. H-1 write their layers under exactly the same cells (a
+    // later chunk of the same batch may take cells that an earlier chunk's window still needs, so the heads must not
+    // run the whole batch one after the other either)
+    bool process_heads_once(const common_batch & batch_in, int32_t n_tokens) {
+        auto * ctx_dft = this->params.ctx_dft;
+        auto * mem_dft = llama_get_memory(ctx_dft);
+
+        bool ok = true;
+        const int32_t n_ub = std::max<int32_t>(1, (int32_t) llama_n_ubatch(ctx_dft));
+        for (int32_t off = 0; ok && off < n_tokens; off += n_ub) {
+            const int32_t n_chunk = std::min(n_ub, n_tokens - off);
+            for (int head = 0; ok && head < n_mtp_layers; ++head) {
+                for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                    for (int32_t k = off; k < off + n_chunk; ++k) {
+                        if (batch_in.tokens[k].seq_id == seq_id) {
+                            llama_memory_seq_rm(mem_dft, seq_id, batch_in.tokens[k].pos[0], -1);
+                            break;
+                        }
+                    }
+                }
+                llama_set_nextn_layer_offset(ctx_dft, head);
+                llama_memory_set_slot_replay(mem_dft, head > 0);
+
+                const int32_t rc = llama_process(ctx_dft, LLAMA_PROCESS_TYPE_DECODE, batch.get_sub_batch(off, n_chunk));
+                if (rc != 0) {
+                    SPC_ERR("llama_process(ctx_dft) head=%d failed rc=%d (pos=%d)\n",
+                            head, (int) rc, (int) batch_in.tokens[off].pos[0]);
+                    ok = false;
+                }
+            }
+        }
+        llama_memory_set_slot_replay(mem_dft, false);
+
+        return ok;
+    }
+
     bool process(const common_batch & batch_in) override {
         if (batch_in.size() <= 0) {
             return true;
@@ -1595,7 +1645,10 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             auto * mem_dft = llama_get_memory(ctx_dft);
 
             bool ok = true;
-            for (int head = 0; head < n_mtp_layers; ++head) {
+            if (chain_heads && slot_replay) {
+                ok = process_heads_once(batch_in, n_tokens);
+            }
+            for (int head = 0; !(chain_heads && slot_replay) && head < n_mtp_layers; ++head) {
                 if (chain_heads) {
                     // ref: https://github.com/ggml-org/llama.cpp/pull/24340/changes#r3413498544
                     for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
