diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 463510c..424c047 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -11,6 +11,7 @@
 #include <cstring>
 #include <limits>
 #include <map>
+#include <set>
 #include <stdexcept>
 #include <unordered_map>
 
@@ -766,7 +767,56 @@ llama_memory_context_ptr llama_kv_cache::init_update(llama_context * lctx, bool
     return std::make_unique<llama_kv_cache_context>(this, lctx, do_shift, std::move(sc_info));
 }
 
+bool llama_kv_cache::set_slot_replay(bool value) {
+    slot_replay = value;
+    return true;
+}
+
+bool llama_kv_cache::slot_replay_fits(const std::vector<llama_ubatch> & ubatches) const {
+    if (sinfos_last.size() != ubatches.size()) {
+        return false;
+    }
+
+    std::vector<std::set<uint32_t>> taken(n_stream);
+
+    for (size_t i = 0; i < ubatches.size(); ++i) {
+        const auto & ubatch = ubatches[i];
+        const auto & sinfo  = sinfos_last[i];
+
+        const uint32_t n_seqs = n_stream > 1 ? ubatch.n_seqs_unq : 1;
+        if (sinfo.n_stream() != n_seqs || sinfo.size()*n_seqs != ubatch.n_tokens) {
+            return false;
+        }
+
+        for (uint32_t s = 0; s < n_seqs; ++s) {
+            const uint32_t strm = seq_to_stream[ubatch.seq_id_unq[s]];
+            if ((uint32_t) sinfo.strm[s] != strm || sinfo.idxs[s].size() != sinfo.size()) {
+                return false;
+            }
+
+            const auto & cells = v_cells[strm];
+            for (const uint32_t idx : sinfo.idxs[s]) {
+                if (idx >= cells.size() || (!cells.is_empty(idx) && taken[strm].count(idx) == 0)) {
+                    return false;
+                }
+            }
+            taken[strm].insert(sinfo.idxs[s].begin(), sinfo.idxs[s].end());
+        }
+    }
+
+    return true;
+}
+
 llama_kv_cache::slot_info_vec_t llama_kv_cache::prepare(const std::vector<llama_ubatch> & ubatches) {
+    // slot replay: the same cells as the last batch placed without replay (see llama_memory_i::set_slot_replay)
+    if (slot_replay) {
+        if (slot_replay_fits(ubatches)) {
+            LLAMA_LOG_DEBUG("%s: slot replay of %zu ubatch(es)\n", __func__, ubatches.size());
+            return sinfos_last;
+        }
+        LLAMA_LOG_WARN("%s: slot replay refused (the recorded cells do not fit the batch), searching instead\n", __func__);
+    }
+
     llama_kv_cache::slot_info_vec_t res;
 
     struct state_t {
@@ -829,6 +879,10 @@ llama_kv_cache::slot_info_vec_t llama_kv_cache::prepare(const std::vector<llama_
         return {};
     }
 
+    if (!slot_replay) {
+        sinfos_last = res;
+    }
+
     return res;
 }
 
