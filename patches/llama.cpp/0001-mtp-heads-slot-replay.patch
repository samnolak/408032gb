@@ -4139,6 +4139,10 @@ void llama_set_nextn_layer_offset(llama_context * ctx, int32_t offset) {
     ctx->set_nextn_layer_offset(offset);
 }
 
+bool llama_memory_set_slot_replay(llama_memory_t mem, bool value) {
+    return mem ? mem->set_slot_replay(value) : false;
+}
+
 llama_memory_t llama_get_memory(const struct llama_context * ctx) {
     if (!ctx) {
         return nullptr;
diff --git a/src/llama-ext.h b/src/llama-ext.h
index fcc78f4..488490a 100644
--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -100,6 +100,13 @@ LLAMA_API void llama_set_embeddings_nextn(struct llama_context * ctx, bool value
 // chain multiple trained NextN heads. Default 0 (first head).
 LLAMA_API void llama_set_nextn_layer_offset(struct llama_context * ctx, int32_t offset);
 
+// Slot replay (multi-head MTP): while value == true, a batch is placed in exactly the KV cells that the last batch
+// decoded with value == false was given, provided those cells are free now and the batch splits into ubatches of the
+// same shape (else the cache searches as usual and logs a warning). The speculative NextN driver uses it so that every
+// head layer of one MTP context writes a batch under the same cells. Returns false if the memory does not support it.
+#define LLAMA_EXT_HAS_SLOT_REPLAY 1
+LLAMA_API bool llama_memory_set_slot_replay(llama_memory_t mem, bool value);
+
 // Marks the entries that a joint decision head (clef) reads, the default is 0
 // See https://github.com/ggml-org/llama.cpp/pull/29831 for details
 // A run of entries with the same value is one span, spans must be separated by entries with value 0
diff --git a/src/llama-kv-cache-iswa.cpp b/src/llama-kv-cache-iswa.cpp
index e918664..db3ac25 100644
--- a/src/llama-kv-cache-iswa.cpp
+++ b/src/llama-kv-cache-iswa.cpp
@@ -361,3 +361,10 @@ const llama_kv_cache_context * llama_kv_cache_iswa_context::get_swa()  const {
 
     return static_cast<const llama_kv_cache_context *>(ctx_swa.get());
 }
+
+bool llama_kv_cache_iswa::set_slot_replay(bool value) {
+    const bool ok_base = kv_base->set_slot_replay(value);
+    const bool ok_swa  = kv_swa ->set_slot_replay(value);
+
+    return ok_base && ok_swa;
+}
